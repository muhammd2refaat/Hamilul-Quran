# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME="Hamilul-Quran"
APP_ENV=development          # development | production
DEBUG=true

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://muhammedrefaat@localhost:5432/hamilul_quran_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Sessions & Encryption ─────────────────────────────────────────────────────
# Secret for Starlette SessionMiddleware (Authlib OAuth state/nonce).
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SESSION_SECRET
# Fernet key for encrypting stored Google refresh tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_TO_A_FERNET_KEY

# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/calendar.events"
REGISTRATION_TOKEN_TTL_SECONDS=900

# ─── Frontend / Uploads ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads

# ─── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ─── Admin seed credentials (used only by full_seed.py) ────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ─── Outbound email (Contact Us / platform requests notifications) ─────────────
# Leave SMTP_HOST blank to disable — sends are skipped (logged, not raised)
# rather than failing whatever triggered them. See Back-end/app/core/email.py.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Envelope "From" — falls back to SMTP_USERNAME if unset.
SMTP_FROM_EMAIL=
# Where Contact Us messages / requests (free trial, reschedule, ...) get
# emailed. Falls back to ADMIN_EMAIL above if unset — kept separate since
# that one is the admin login seed account, not necessarily the same inbox.
CONTACT_NOTIFICATION_EMAIL=

# ─── Error tracking (optional) ─────────────────────────────────────────────────
# Leave blank to disable — no error tracking runs unless this is set.
SENTRY_DSN="https://fa79571ffd0c41059482c6d8ea943ce6@o4511852850249728.ingest.us.sentry.io/4511852881313792"
