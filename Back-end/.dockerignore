# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/

# Environment files (injected at runtime)
.env
.env.*
!.env.example

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
tests/
test_*.py
pytest.ini

# Git
.git/
.gitignore

# Docs / scripts not needed in container
docs/
*.cjs
*.md
README*

# Alembic pycache
alembic/versions/__pycache__/

# Logs
*.log
dump.rdb

# Manual dev / seed / smoke-test scripts — never needed by the running
# container, and drop_tables.py in particular must never ship to prod.
create_tables.py
drop_tables.py
full_seed.py
seed.py
seed_history.py
test_allocations.py
test_api.py
test_complaints_api.py
